# Copy to .env and adjust for your environment.
# cp .env.example .env

# URL OCR (core feature) — allowlist hosts you trust (comma-separated)
OCR_URL_FETCH_ENABLED=true
OCR_URL_FETCH_ALLOWED_HOSTS=raw.githubusercontent.com,github.com

# Tesseract
OCR_LANGUAGE=eng

# Optional: production (disables Swagger UI)
# SPRING_PROFILES_ACTIVE=prod

# Optional: browser clients (Swagger UI, frontends)
# OCR_CORS_ENABLED=true
# OCR_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,https://myapp.example.com

# Optional: Mongo persistence (use docker compose --profile mongo)
# SPRING_PROFILES_ACTIVE=mongo
# OCR_STORAGE_TYPE=mongo
# MONGODB_URI=mongodb://mongo:27017/ocr
